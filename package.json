{
  "name": "sdet-services",
  "private": true,
  "type": "module",
  "description": "Greenbar Quality Engineering static site",
  "scripts": {
    "serve": "http-server . -p 4173 -c-1 --silent",
    "typecheck": "tsc --noEmit",
    "lint": "html-validate index.html 404.html sample-audit.html",
    "test": "playwright test",
    "test:ui": "playwright test --ui",
    "check": "npm run typecheck && npm run lint && npm test",
    "fonts": "node scripts/copy-fonts.mjs",
    "og-image": "node scripts/og-image.mjs"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.14.0",
    "@fontsource-variable/bricolage-grotesque": "^5.3.0",
    "@fontsource/ibm-plex-sans": "^5.3.0",
    "@fontsource/jetbrains-mono": "^5.3.0",
    "@playwright/test": "^1.64.1",
    "@types/node": "^26.6.6",
    "html-validate": "^11.18.0",
    "http-server": "^14.1.1",
    "typescript": "^7.0.2"
  }
}
