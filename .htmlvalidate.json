{
  "extends": ["html-validate:recommended"],
  "rules": {
    "doctype-style": "off",
    "no-inline-style": "off",
    "no-redundant-for": "off",
    "void-style": "off",
    "no-trailing-whitespace": "off",
    "form-dup-name": ["error", { "shared": ["radio", "checkbox", "button", "reset", "submit"] }]
  }
}
